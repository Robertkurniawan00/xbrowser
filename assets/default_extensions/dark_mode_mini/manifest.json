{
  "manifest_version": 3,
  "name": "Dark Mode Everywhere",
  "version": "1.3.0",
  "description": "Mengubah tampilan seluruh situs web menjadi tema gelap modern dengan kontras nyaman.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dark Mode Everywhere"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.twitch.tv/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.bilibili.com/*"
      ],
      "css": [
        "dark_theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ]
}
